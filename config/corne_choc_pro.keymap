/*
 * Keebart Corne Choc Pro BT with nice!view replacing the inner extra column.
 * Physical layout: 42 keys, 6 columns x 3 rows per half + 3-key thumb cluster.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <locale/keys_sv.h>
#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/42.h>


#define WIN_BASE  0
#define LOWER     1
#define RAISE     2
#define CODE      3
#define SYS       4

#define WIN_LT   SV_LT
#define WIN_GT   SV_GT
#define MAC_LT   GRAVE
#define MAC_GT   LS(GRAVE)
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // Thumb keys.

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <220>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <0>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <220>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <0>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/*
 * Keep the board's existing default_transform label so the right-half board file
 * still applies its col-offset = <7> override.
 */
&default_transform {
    rows = <4>;
    columns = <14>;
    map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                                RC(3,3) RC(3,4) RC(3,5)  RC(3,8) RC(3,9) RC(3,10)
    >;
};

 / {
    chosen {
        zmk,physical-layout = &hybrid42_layout;
    };

    hybrid42_layout: hybrid42_layout {
        compatible = "zmk,physical-layout";
        display-name = "Hybrid 42";
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 100 100    0   37       0     0     0>
            , <&key_physical_attrs 100 100  100   37       0     0     0>
            , <&key_physical_attrs 100 100  200   12       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   12       0     0     0>
            , <&key_physical_attrs 100 100  500   24       0     0     0>
            , <&key_physical_attrs 100 100  800   24       0     0     0>
            , <&key_physical_attrs 100 100  900   12       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100   12       0     0     0>
            , <&key_physical_attrs 100 100 1200   37       0     0     0>
            , <&key_physical_attrs 100 100 1300   37       0     0     0>

            , <&key_physical_attrs 100 100    0  137       0     0     0>
            , <&key_physical_attrs 100 100  100  137       0     0     0>
            , <&key_physical_attrs 100 100  200  112       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  112       0     0     0>
            , <&key_physical_attrs 100 100  500  124       0     0     0>
            , <&key_physical_attrs 100 100  800  124       0     0     0>
            , <&key_physical_attrs 100 100  900  112       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  112       0     0     0>
            , <&key_physical_attrs 100 100 1200  137       0     0     0>
            , <&key_physical_attrs 100 100 1300  137       0     0     0>

            , <&key_physical_attrs 100 100    0  237       0     0     0>
            , <&key_physical_attrs 100 100  100  237       0     0     0>
            , <&key_physical_attrs 100 100  200  212       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  212       0     0     0>
            , <&key_physical_attrs 100 100  500  224       0     0     0>
            , <&key_physical_attrs 100 100  800  224       0     0     0>
            , <&key_physical_attrs 100 100  900  212       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  212       0     0     0>
            , <&key_physical_attrs 100 100 1200  237       0     0     0>
            , <&key_physical_attrs 100 100 1300  237       0     0     0>

            , <&key_physical_attrs 100 100  350  312       0     0     0>
            , <&key_physical_attrs 100 100  450  312    1200   450   412>
            , <&key_physical_attrs 100 150  548  283    2400   548   433>
            , <&key_physical_attrs 100 150  752  283 (-2400)   852   433>
            , <&key_physical_attrs 100 100  850  312 (-1200)   950   412>
            , <&key_physical_attrs 100 100  950  312       0     0     0>
            ;
    };

    behaviors {
        fht: function_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Function Hold-Tap";
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_code {
            timeout-ms = <50>;
            key-positions = <37 40>;
            bindings = <&mo CODE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_base_layer {
            bindings = <
  &kp TAB    &kp Q          &kp W          &kp E           &kp R           &kp T             &kp Y      &kp U           &kp I           &kp O          &kp P                  &kp SV_A_RING
  &kp ESC    &hml LGUI A    &hml LALT S    &hml LSHFT D    &hml LCTRL F    &kp G             &kp H      &hmr RCTRL J    &hmr RSHFT K    &hmr RALT L    &hmr RGUI SV_O_UMLAUT  &kp SV_A_UMLAUT
  &kp LSHFT  &kp Z          &kp X          &kp C           &kp V           &kp B             &kp N      &kp M           &kp COMMA       &kp DOT        &kp SV_MINUS           &kp BSPC
                                         &lt SYS LGUI      &mo RAISE       &kp RET           &kp SPACE  &mo LOWER       &mo CODE
            >;
        };


       
        lower_layer {
    bindings = <
&trans     &kp SV_EXCL    &kp SV_HASH    &kp SV_DLLR    &kp SV_PRCNT   &kp SV_ASTRK   &kp HOME       &kp PG_UP      &kp UP        &kp END       &kp C_MUTE       &kp C_VOL_UP
        &kp ESC    &kp SV_AT      &kp SV_UNDER   &kp SV_SQT     &kp SV_DQT     &kp SV_COLON  &trans         &kp LEFT       &kp DOWN     &kp RIGHT     &kp C_VOL_DN     &kp C_VOL_UP
  &kp LSHFT  &kp SV_AT        &kp SV_DLLR     &kp SV_ASTRK     &kp SV_QMARK       &kp SV_PIPE        &kp PG_DN       &kp INS        &kp DELETE    &trans        &trans           &trans
                                              &trans            &trans            &kp RET            &kp SPACE       &trans         &trans
    >;
};

       
        raise_layer {
    bindings = <
      &trans     &fht F1 SV_EXCL  &fht F2 SV_DQT  &fht F3 SV_HASH  &fht F4 SV_CURREN  &fht F5 SV_PRCNT  &trans       &kp SV_N7     &kp SV_N8     &kp SV_N9     &kp SV_PLUS   &kp SV_ASTRK
  &kp ESC    &fht F11 SV_N1   &fht F12 SV_N2  &kp SV_N3        &kp SV_N4          &kp SV_N5        &trans       &kp SV_N4     &kp SV_N5     &kp SV_N6     &kp SV_MINUS  &kp SV_EQUAL
  &kp LSHFT  &kp SV_BSLH    &kp SV_PIPE    &kp SV_PLUS    &kp SV_EQUAL   &kp GRAVE         &kp SV_N0      &kp SV_N1     &kp SV_N2     &kp SV_N3     &kp SV_N0     &trans
                                         &trans           &trans           &kp RET           &kp SPACE    &trans             &trans
    >;
};

        
        code_layer {
    bindings = <
  &kp SV_GRAVE  &kp SV_TILDE  &kp SV_HASH   &kp SV_PRCNT  &kp SV_ASTRK  &kp SV_AMPS    &trans       &trans       &kp SV_LPAR  &kp SV_RPAR  &kp WIN_LT   &kp WIN_GT
  &kp SV_EXCL   &kp SV_QMARK  &kp SV_COLON  &kp SV_SEMI   &kp SV_FSLH   &kp SV_BSLH    &trans       &trans       &kp SV_LBKT  &kp SV_RBKT  &trans       &trans
  &kp SV_SQT    &kp SV_DQT    &kp SV_UNDER  &kp SV_PIPE   &kp COMMA     &kp DOT        &trans       &trans       &kp SV_LBRC  &kp SV_RBRC  &trans       &kp BSPC
                                           &trans       &trans       &kp RET        &kp SPACE    &trans           &trans
    >;
};

        sys_layer {
            bindings = <
  &trans  &trans           &trans             &trans             &trans     &trans        &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans           &trans           &rgb_ug RGB_TOG    &trans
  &trans  &studio_unlock   &ext_power EP_OFF  &ext_power EP_ON   &trans     &trans        &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &trans
  &trans  &bt BT_CLR       &trans             &trans             &trans     &to WIN_BASE  &trans           &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans           &trans             &trans
                                       &trans                  &trans      &trans        &trans           &trans           &trans
            >;
        };

    };
};
